# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交
# 阿里云 DashScope（通义千问 / 万相图像）API Key —— 必填
# 获取：https://dashscope.console.aliyun.com
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# 可选覆盖（不填则用 server.py 中的默认值）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# CLIP_MODEL_DIR=models/clip-vit-base-patch16
# FLASK_DEBUG=0
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5000
